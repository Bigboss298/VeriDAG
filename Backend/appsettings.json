{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": [
    "http://localhost:3001",
    "http://localhost:3000"
  ],
  "TheGraph": {
    "SubgraphUrl": "http://localhost:8000/subgraphs/name/datatrust-nexus",
    "StudioUrl": "https://api.studio.thegraph.com/query/<YOUR_SUBGRAPH_ID>/datatrust-nexus/version/latest"
  },
  "Blockchain": {
    "RpcUrl": "https://your-blockdag-rpc-url",
    "ChainId": "1",
    "Contracts": {
      "InstitutionRegistry": "0x0000000000000000000000000000000000000000",
      "DataVaultContract": "0x0000000000000000000000000000000000000000",
      "AccessControlContract": "0x0000000000000000000000000000000000000000",
      "AuditTrailContract": "0x0000000000000000000000000000000000000000"
    }
  },
  "IPFS": {
    "ApiUrl": "http://localhost:5001/api/v0",
    "Gateway": "http://localhost:8080/ipfs/",
    "UsePinata": false,
    "PinataApiKey": "",
    "PinataSecretKey": ""
  },
  "Security": {
    "EnableEncryption": true,
    "KeyRotationDays": 90,
    "MaxFileSize": 104857600
  }
}
